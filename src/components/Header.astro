---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/over', label: 'Over' },
  { href: '/nieuws', label: 'Nieuws' },
  { href: '/recepten', label: 'Recepten' },
  { href: '/tools', label: 'Tools' },
  { href: '/partners', label: 'Partners' },
  { href: '/contact', label: 'Contact' },
];

const huidigPad = Astro.url.pathname;

function isActief(href: string) {
  if (href === '/') return huidigPad === '/';
  return huidigPad.startsWith(href);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="SMS Dieet homepage">
      <svg width="34" height="34" viewBox="0 0 34 34" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="17" cy="17" r="17" fill="#4a8768"/>
        <path d="M17 8c4.5 3 6.5 6.7 6.5 10.2C23.5 22.5 20.6 26 17 26s-6.5-3.5-6.5-7.8C10.5 14.7 12.5 11 17 8Z" fill="#e7f2ea"/>
        <path d="M17 13c2.4 1.7 3.4 3.7 3.4 5.6 0 2.4-1.5 4.4-3.4 4.4" stroke="#4a8768" stroke-width="1.4" stroke-linecap="round" fill="none"/>
      </svg>
      <span>SMS<strong>Dieet</strong></span>
    </a>

    <nav class="site-header__nav" aria-label="Hoofdmenu">
      <button class="site-header__toggle" id="menu-toggle" aria-expanded="false" aria-controls="menu-lijst">
        <span></span><span></span><span></span>
        <span class="sr-only">Menu</span>
      </button>
      <ul id="menu-lijst">
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActief(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 247, 239, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--kleur-rand);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 78px;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-family: var(--font-koptekst);
    font-size: 1.3rem;
    color: var(--kleur-groen-donker);
  }

  .site-header__logo strong {
    color: var(--kleur-koraal-donker);
  }

  .site-header__nav ul {
    list-style: none;
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    display: inline-block;
    padding: 10px 14px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--kleur-tekst);
    border-radius: 999px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .site-header__nav a:hover {
    background: var(--kleur-groen-licht);
    color: var(--kleur-groen-donker);
  }

  .site-header__nav a[aria-current='page'] {
    background: var(--kleur-groen);
    color: #fff;
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--kleur-rand);
    background: var(--kleur-wit);
    cursor: pointer;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    background: var(--kleur-groen-donker);
    margin: 0 8px;
    border-radius: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  @media (max-width: 860px) {
    .site-header__toggle { display: flex; }

    .site-header__nav ul {
      position: absolute;
      top: 78px;
      left: 0;
      right: 0;
      flex-direction: column;
      background: var(--kleur-wit);
      border-bottom: 1px solid var(--kleur-rand);
      padding: 10px 24px 18px;
      gap: 2px;
      display: none;
    }

    .site-header__nav ul.open {
      display: flex;
    }

    .site-header__nav a {
      display: block;
      padding: 12px 10px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const lijst = document.getElementById('menu-lijst');
  toggle?.addEventListener('click', () => {
    const open = lijst?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
