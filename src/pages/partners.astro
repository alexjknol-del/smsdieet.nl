---
import Layout from '../layouts/Layout.astro';

const partners = [
  {
    naam: 'Voedingscentrum',
    url: 'https://www.voedingscentrum.nl/nl/afvallen.aspx',
    beschrijving:
      'Het Voedingscentrum is de onafhankelijke, door de Nederlandse overheid ondersteunde voorlichtingsorganisatie over gezonde en veilige voeding. Een betrouwbare bron voor wie feiten wil checken over voeding en afvallen.',
  },
  {
    naam: 'Gezondheid.nl',
    url: 'https://gezondheid.nl/',
    beschrijving:
      'Een van de grootste Nederlandse platforms over gezondheid, met artikelen over voeding, leefstijl en welzijn, geschreven en gecontroleerd door redacteuren en vakspecialisten.',
  },
  {
    naam: 'Tatanka',
    url: 'https://www.tatanka.nl/nl/shroomshop/magic-mushroom-grow-kits/',
    beschrijving:
      'Tatanka is een Nederlandse smartshop met paddo growkits en smartshopproducten, met uitleg per soort en een overzicht van het aanbod.',
    anchor: 'Paddo mushroom growkit',
  },
  {
    naam: 'Smartific',
    url: 'https://smartific.nl/joint-roller/',
    beschrijving:
      'Smartific is een Nederlandse smartshop met magic truffels, growkits en smartshopproducten, inclusief productinformatie per artikel.',
    anchor: 'Joint roller kopen',
  },
  {
    naam: 'The Headshop',
    url: 'https://www.headshop.nl/nl/super-bali-gold-kratom/',
    beschrijving:
      'The Headshop is een Nederlandse headshop met kratom en smartshopproducten, met een uitgebreid overzicht per soort en sterkte.',
    anchor: 'Super Bali Gold Kratom',
  },
  {
    naam: 'Paddo.shop',
    url: 'https://www.paddo.shop/mexican-paddo-growkit/',
    beschrijving:
      'Paddo.shop is een Nederlandse webshop gespecialiseerd in paddo growkits, met uitleg per kweekset en kweekinstructies.',
    anchor: 'Mexican paddo',
  },
  {
    naam: 'Magictruffels.shop',
    url: 'https://www.magictruffels.shop/',
    beschrijving:
      'Magictruffels.shop is een Nederlandse webshop voor magic truffels, met een overzicht per soort en de werking ervan.',
    anchor: 'mushrocks truffels',
  },
  {
    naam: 'De Foodtruck Club',
    url: 'https://defoodtruckclub.nl/foodtrucks/pizza-foodtruck',
    beschrijving:
      'De Foodtruck Club bemiddelt in foodtrucks voor bedrijfsfeesten, bruiloften en evenementen, met per type truck een overzicht van het aanbod en de mogelijkheden.',
    anchor: 'foodtrucks pizza',
  },
];
---

<Layout
  titel="Partners"
  beschrijving="De partners en autoriteiten op het gebied van gezondheid en voeding waar SMSDieet.nl naar verwijst."
>
  <section class="sectie">
    <div class="container smal tekst-centreren">
      <span class="eyebrow">Partners</span>
      <h1>Bronnen en partners waar we naar verwijzen</h1>
      <p>
        We verwijzen graag naar betrouwbare, toonaangevende bronnen op het
        gebied van voeding en gezondheid. Op dit moment werken we samen met
        de onderstaande partners. Dit overzicht breiden we de komende tijd
        verder uit.
      </p>
    </div>
  </section>

  <section class="sectie">
    <div class="container kaarten-grid grid-2">
      {partners.map((partner) => (
        <div class="kaart partner-kaart">
          <h3>{partner.naam}</h3>
          <p>{partner.beschrijving}</p>
          <a class="knop knop--outline" href={partner.url} target="_blank" rel="noopener">
            {partner.anchor || `Bezoek ${partner.naam}`}
          </a>
        </div>
      ))}

      <div class="kaart partner-kaart partner-kaart--placeholder">
        <h3>Binnenkort meer partners</h3>
        <p>
          We breiden dit overzicht uit met meer linkpartners op het gebied
          van gezonde voeding, beweging en leefstijl. Wil je met SMSDieet.nl
          samenwerken?
        </p>
        <a class="knop knop--groen" href="/contact">Neem contact op</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .partner-kaart {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .partner-kaart h3 {
    margin-bottom: 4px;
  }

  .partner-kaart a {
    margin-top: auto;
    align-self: flex-start;
  }

  .partner-kaart--placeholder {
    background: var(--kleur-groen-licht);
    border-style: dashed;
  }
</style>
