---
import Layout from '../layouts/Layout.astro';

const partners = [
  {
    naam: 'Voedingscentrum',
    url: 'https://www.voedingscentrum.nl/nl/afvallen.aspx',
    beschrijving:
      'Het Voedingscentrum is de onafhankelijke, door de Nederlandse overheid ondersteunde voorlichtingsorganisatie over gezonde en veilige voeding. Een betrouwbare bron voor wie feiten wil checken over voeding en afvallen.',
  },
  {
    naam: 'Gezondheid.nl',
    url: 'https://gezondheid.nl/',
    beschrijving:
      'Een van de grootste Nederlandse platforms over gezondheid, met artikelen over voeding, leefstijl en welzijn, geschreven en gecontroleerd door redacteuren en vakspecialisten.',
  },
];
---

<Layout
  titel="Partners"
  beschrijving="De partners en autoriteiten op het gebied van gezondheid en voeding waar SMSDieet.nl naar verwijst."
>
  <section class="sectie">
    <div class="container smal tekst-centreren">
      <span class="eyebrow">Partners</span>
      <h1>Bronnen en partners waar we naar verwijzen</h1>
      <p>
        We verwijzen graag naar betrouwbare, toonaangevende bronnen op het
        gebied van voeding en gezondheid. Op dit moment werken we samen met
        de onderstaande partners. Dit overzicht breiden we de komende tijd
        verder uit.
      </p>
    </div>
  </section>

  <section class="sectie">
    <div class="container kaarten-grid grid-2">
      {partners.map((partner) => (
        <div class="kaart partner-kaart">
          <h3>{partner.naam}</h3>
          <p>{partner.beschrijving}</p>
          <a class="knop knop--outline" href={partner.url} target="_blank" rel="noopener">
            Bezoek {partner.naam}
          </a>
        </div>
      ))}

      <div class="kaart partner-kaart partner-kaart--placeholder">
        <h3>Binnenkort meer partners</h3>
        <p>
          We breiden dit overzicht uit met meer linkpartners op het gebied
          van gezonde voeding, beweging en leefstijl. Wil je met SMSDieet.nl
          samenwerken?
        </p>
        <a class="knop knop--groen" href="/contact">Neem contact op</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .partner-kaart {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .partner-kaart h3 {
    margin-bottom: 4px;
  }

  .partner-kaart a {
    margin-top: auto;
    align-self: flex-start;
  }

  .partner-kaart--placeholder {
    background: var(--kleur-groen-licht);
    border-style: dashed;
  }
</style>
