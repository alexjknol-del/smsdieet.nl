---
import Layout from '../layouts/Layout.astro';
---

<Layout titel="Pagina niet gevonden" beschrijving="Deze pagina bestaat niet (meer).">
  <section class="sectie tekst-centreren">
    <div class="container smal">
      <span class="eyebrow">404</span>
      <h1>Deze pagina bestaat niet (meer)</h1>
      <p>Misschien is de pagina verplaatst, of klopt de link niet meer.</p>
      <a class="knop knop--groen" href="/">Terug naar de homepage</a>
    </div>
  </section>
</Layout>
